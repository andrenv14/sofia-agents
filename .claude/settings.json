{
  "plansDirectory": "docs/plans",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/estado.sh",
            "timeout": 15,
            "statusMessage": "Lendo estado do repositório..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "awk '/^## Agora/{f=1;next}/^## /{f=0}f' ESTADO.md",
            "timeout": 5,
            "statusMessage": "Reinjetando ESTADO.md pós-compactação..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/pedir-permissao.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protege-arquivos.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch *)",
      "Bash(git ls-remote *)",
      "Bash(git rev-parse *)",
      "Bash(git merge-base *)",
      "Bash(git merge-tree *)",
      "Bash(npm run test:agent)",
      "Bash(npx vitest run *)",
      "Bash(node --check *)",
      "Bash(pm2 list)",
      "Bash(pm2 jlist *)",
      "Bash(pm2 describe *)",
      "Bash(pm2 logs * --nostream*)",
      "Bash(crontab -l)",
      "Bash(cat *)",
      "Bash(sed -n *)",
      "Bash(grep *)",
      "Bash(ls *)",
      "Bash(wc *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(hostname)",
      "Bash(date *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git check-ignore *)",
      "Bash(git ls-files *)",
      "Bash(git worktree list)",
      "Bash(git stash list)",
      "Bash(pgrep *)",
      "Bash(ps *)",
      "Bash(ss *)",
      "Bash(find *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(diff *)",
      "Bash(node --version)",
      "Bash(npm --version)",
      "Bash(rclone --version)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git clean *)",
      "Bash(pm2 delete *)",
      "Bash(pm2 kill)",
      "Bash(crontab -r)",
      "Bash(crontab -e)",
      "Bash(psql * -c *DROP*)",
      "Bash(psql * -c *DELETE*)",
      "Bash(psql * -c *TRUNCATE*)",
      "Bash(psql * -c *UPDATE*)",
      "Bash(psql * -f *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(pm2 restart *)",
      "Bash(pm2 reload *)",
      "Bash(pm2 stop *)",
      "Bash(pm2 start *)",
      "Bash(crontab *)",
      "Bash(psql * -c INSERT*)",
      "Bash(psql * -c UPDATE*)",
      "Bash(npm run migrate*)",
      "Bash(sudo *)"
    ]
  }
}
